# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nomor WA penerima orderan (format 62..., tanpa + dan tanpa 0 depan)
NEXT_PUBLIC_WA_NUMBER=628152425391

# Secret untuk menandatangani token QR meja (HMAC).
# Isi string acak panjang, misal hasil: openssl rand -base64 24
MEJA_SECRET=

# Domain publik untuk QR sticker. Lokal: biarkan default localhost:3000.
# Production: isi tanpa trailing slash, misal https://qr-fnb.vercel.app
NEXT_PUBLIC_BASE_URL=
